{
	"manifest_version": 3,
	"name": "TVING Watch History Plus",
	"version": "26.29.1",
	"description": "TVING 시청 내역을 프로그램 단위로 보여줍니다.",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://www.tving.com/my"],
			"js": ["content.js"],
			"css": ["content.css"]
		}
	],
	"permissions": ["cookies", "webNavigation", "scripting"],
	"host_permissions": [
		"https://api.tving.com/*",
		"https://www.tving.com/*"
	]
}
